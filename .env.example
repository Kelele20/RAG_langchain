# ==========================================================
# RAG_langchain 环境变量配置模板 (.env.example)
# 使用方法：复制本文件为 .env，并填入您自己的真实 API 密钥
# ==========================================================

# 1. DeepSeek 官方 API Key (推荐使用)
# 获取地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 2. OpenAI 官方 API Key
# 获取地址: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# 3. 阿里云百炼 / 通义千问 (DashScope) API Key
# 获取地址: https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 4. 智谱 AI (Zhipu / GLM) API Key
# 获取地址: https://open.bigmodel.cn
ZHIPUAI_API_KEY=your_zhipu_api_key_here

# 5. 月之暗面 (Moonshot / Kimi) API Key
# 获取地址: https://platform.moonshot.cn
MOONSHOT_API_KEY=your_moonshot_api_key_here

# 6. OpenRouter 全球模型聚合网关 API Key
# 获取地址: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
